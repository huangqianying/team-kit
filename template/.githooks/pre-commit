#!/usr/bin/env bash
# 提交准入门禁 · 凭据防泄漏——部署凭据文件与明文口令不得进仓库。
#
# UI 走查门禁在 `commit-msg`，不在这里：**pre-commit 不接收任何参数**，
# 且 `-m` 的消息要等它跑完才写进 COMMIT_EDITMSG，在这里读消息只会读到上一次的。
# 挡不住 --no-verify（如实说）。
set -euo pipefail

# ═══ A. 凭据防泄漏 ═══════════════════════════════════════════
staged=$(git diff --cached --name-only --diff-filter=ACMR || true)

# A1. 凭据文件本身被 staged（含 git add -f 绕过 .gitignore）
cred_hit=$(printf '%s\n' "$staged" | grep -E '(^|/)\.deploy/credentials\.ini$|(^|/)\.env(\.|$)' | grep -v '\.example$' || true)
if [ -n "$cred_hit" ]; then
  echo "❌ 凭据文件不得提交：" >&2
  printf '   %s\n' $cred_hit >&2
  echo "   这类文件只存在于本地磁盘。要提交模板请改 .deploy/credentials.ini.example（不得填真值）。" >&2
  exit 1
fi

# A2. 提交内容里出现有真值的密码字段
#    值必须「像口令」才报：配置文件允许裸值；代码文件只认带引号的字面量。
#    散文里的「password = 不算」「密码 = 见配置」是中文说明不是口令；${VAR}、<占位>、
#    ***、xxx 同理。用 python 判，grep 表达不了这个。
#    测试文件（tests/、.test.、.spec. 等）与 .example 跳过内容扫描：夹具本就该带假口令，
#    逐个加白名单是打地鼠。
#    代价（如实说）：真凭据藏进测试文件不会被本门拦住。凭据**文件名**的拦截（A1）
#    不受此豁免，对所有路径生效。
secret_hit=$(git diff --cached -U0 --diff-filter=ACMR -- . ':(exclude)*.example' \
  | python3 -c '
import re, sys
KEY = re.compile(r"(DEPLOY_PASSWORD|password|passwd|secret_key|api_key|token)\b\s*[=:]\s*", re.I)
# 空字面量须在相邻的闭引号结束，不能跨到下一个字段的开引号。
QUOTED = re.compile(r"^([\x27\"`])(.*?)\1")
DUMMY = {"secret", "dummy", "fake", "test", "testing", "example", "password", "pass", "none", "null"}
PLACEHOLDER = re.compile(r"^[\x27\"]?(\$\{?[A-Za-z_]|<|\*{3,}|\.{3}|xxx|placeholder|changeme|your[-_]?)", re.I)
TESTPATH = re.compile(r"(^|/)tests?/|\.test\.|\.spec\.|(^|/)test_|_test\.", re.I)
CONFIGPATH = re.compile(r"(^|/)\.env(?:\.|$)|\.(?:env|ini|ya?ml|conf|properties|toml)$", re.I)
hits = []
skip = False
path = ""
for line in sys.stdin:
    if line.startswith("+++ "):                 # 新文件段开始：判这个文件要不要扫
        path = line[4:].strip()
        path = path[2:] if path.startswith("b/") else path
        skip = bool(TESTPATH.search(path))
        continue
    if skip or not line.startswith("+"):
        continue
    # 一行可能同时有空表单字段与真实口令，须逐字段扫描。
    for m in KEY.finditer(line):
        remainder = line[m.end():].lstrip()
        if CONFIGPATH.search(path):
            val = (remainder.split(None, 1)[0] if remainder else "").strip("\x27\"`,;)")
        else:
            literal = QUOTED.match(remainder)
            if not literal:
                continue
            val = literal.group(2)
        if not val.strip() or PLACEHOLDER.match(val):
            continue
        if not val.isascii():          # 中文说明文字，不是口令
            continue
        if len(val) < 4:               # 太短不像口令（含空值、= 号残留）
            continue
        if val.lower() in DUMMY:       # 常见假值
            continue
        hits.append(line.rstrip())
        break
print("\n".join(hits[:5]))
' || true)
if [ -n "$secret_hit" ]; then
  echo "❌ 提交内容疑似含明文凭据：" >&2
  printf '%s\n' "$secret_hit" | head -5 >&2
  echo "   改为从 .deploy/credentials.ini 读取，或用 \${DEPLOY_PASSWORD} 占位。" >&2
  echo "   确属误报时用 git commit --no-verify（并说明理由）。" >&2
  exit 1
fi

# ═══ B. 被引文档编辑触发 spec 引用核 ══════════════════════════
# spec 用行号引用契约 / 设计稿 / UI 规范；被引方一改，其后所有引用即指向错误
# 内容。此前只有 spec 侧跑 check-spec-refs 时才发现——实发七次全靠偶然撞上，
# 其中两次改契约后 develop 的 spec 门红了数小时，下游正在这道红门上做发布证据。
# 这里把「谁改谁负责」落成机械门：改被引方就当场核。
#
# 触发面 = spec §1.2 mapping 声明的被引路径；改动其它文件不触发。
# 代价（如实说）：同样挡不住 --no-verify；spec 自身被改不由本门负责（它归 dev00:gate）。
referenced_paths_re='^(docs/(prds|designs|rules)/|docs/reviews/.*(PM需求终裁|PM需求裁定|PM评审))'
# core.quotepath=false：中文路径默认会被转义成 "docs/rules/\345\233\242..." 带引号输出，
# 开头的引号让 `^docs/` 匹配不上——docs/rules/ 下的规范多为中文名（UI设计规范、团队协作契约），
# 不关掉就是整条规则对它们静默失效。
ref_hit="$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR | grep -E "$referenced_paths_re" || true)"

if [ -n "$ref_hit" ]; then
  checker="docs/superpowers/specs/check-spec-refs.mjs"
  if [ -f "$checker" ]; then
    if ! ref_out="$(node "$checker" 2>&1)"; then
      # checker 跑不起来（依赖缺失、语法错）与「引用失配」是两回事，分开说，
      # 否则会把环境问题误报成产物问题、把人引到错误的修法上。
      if ! printf '%s' "$ref_out" | grep -q 'spec-ref-lint\|SPEC_\|: '; then
        echo "✗ 提交被拒：spec 引用核无法运行（非引用失配）" >&2
        printf '%s\n' "$ref_out" | head -5 | sed 's/^/    /' >&2
        echo "  → 先修好 checker 可运行性（依赖是否已装），再提交。" >&2
        exit 1
      fi
      echo "✗ 提交被拒：改动了 spec 的被引文档，引用核不通过" >&2
      echo "  触及：" >&2
      printf '    %s\n' $ref_hit >&2
      echo "$ref_out" | grep -vE '^spec-ref-lint ' | head -8 | sed 's/^/    /' >&2
      echo "  → 先跑 \`pnpm spec:reanchor\` 重算锚，再提交；" >&2
      echo "    若失配属引用目标失效（工具报「无法自动修复」），需人工改正文引用行号。" >&2
      exit 1
    fi
  fi
fi


exit 0
