#!/usr/bin/env bash
# 提交准入门禁 · 凭据防泄漏——凭据文件与明文口令不得进仓库。
#
# 本文件是团队基建内核，各工程逐字相同；工程专属的路径、白名单与提示写在
# `.githooks/project.conf`（bash 变量文件，由本脚本 source，kit 同步不覆盖）。
# 变量清单见下方「工程配置」。project.conf 缺失时按内核默认判据照常扫描，并提示一行。
#
# 挡不住 git commit --no-verify（如实说）。钩子要生效须先执行 `bash .githooks/install.sh`。
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
conf="${root}/.githooks/project.conf"

# ═══ 工程配置（全部可选；正则一律为 Python re 语法，用 re.search 匹配仓库相对路径）═══
# HOOK_CRED_FILE_RE           追加的凭据文件路径；命中即拒（以 .example 结尾的除外）。
# HOOK_TEST_PATH_RE           追加的测试路径；命中的文件不做口令内容扫描。
# HOOK_CONFIG_PATH_RE         追加的配置类路径；命中的文件连裸值一起扫。
# HOOK_SECRET_ALLOW_VALUE_RE  已知不是口令的业务取值；口令字段的值整体匹配时放行（re.fullmatch）。
# HOOK_CRED_HINT              拒绝时附加的一行指引（本工程凭据放哪、模板叫什么）。
# CHECK_AFTER_EDIT            （不归本脚本用）写文件后由运行时钩子执行的工程检查命令，被改路径作参数追加；
#                             非 0 退出时输出作为提醒注入，8 秒超时。见 skills/team-check/SKILL.md。
HOOK_CRED_FILE_RE=""
HOOK_TEST_PATH_RE=""
HOOK_CONFIG_PATH_RE=""
HOOK_SECRET_ALLOW_VALUE_RE=""
HOOK_CRED_HINT=""
if [ -f "$conf" ]; then
  # shellcheck source=/dev/null
  source "$conf"
else
  echo "ℹ️  未找到 .githooks/project.conf：按内核默认判据扫描（无工程追加路径、无白名单）。" >&2
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "❌ 凭据门禁需要 python3，当前环境找不到；装好后再提交。" >&2
  exit 1
fi

# 判据用 python 写：「值像不像口令」grep 表达不了。
# python 自身出错（正则写错、git 调用失败）以非零退出拦下，不当作「没有命中」放行。
export HOOK_CRED_FILE_RE HOOK_TEST_PATH_RE HOOK_CONFIG_PATH_RE HOOK_SECRET_ALLOW_VALUE_RE HOOK_CRED_HINT
exec python3 -c '
import os, re, subprocess, sys

def conf_re(name):
    v = os.environ.get(name, "").strip()
    try:
        return re.compile(v) if v else None
    except re.error as e:
        raise SystemExit(f"❌ .githooks/project.conf 的 {name} 不是合法正则：{e}")

CRED_EXTRA = conf_re("HOOK_CRED_FILE_RE")
TEST_EXTRA = conf_re("HOOK_TEST_PATH_RE")
CONFIG_EXTRA = conf_re("HOOK_CONFIG_PATH_RE")
ALLOW_VALUE = conf_re("HOOK_SECRET_ALLOW_VALUE_RE")
HINT = os.environ.get("HOOK_CRED_HINT", "").strip()

def git(*args):
    return subprocess.run(["git", "-c", "core.quotepath=false", *args],
                          check=True, stdout=subprocess.PIPE).stdout

def say(*lines):
    for s in lines:
        print(s, file=sys.stderr)

def tail_hint():
    if HINT:
        say("   " + HINT)

# ─── A1. 凭据文件本身被暂存（含 git add -f 绕过 .gitignore）──────────────
CRED_FILE = re.compile(r"(^|/)\.env(\.|$)")
staged = [p.decode("utf-8", "replace")
          for p in git("diff", "--cached", "--name-only", "-z", "--diff-filter=ACMR").split(b"\0") if p]
cred_hit = [p for p in staged
            if not p.endswith(".example")
            and (CRED_FILE.search(p) or (CRED_EXTRA and CRED_EXTRA.search(p)))]
if cred_hit:
    say("❌ 凭据文件不得提交：", *("   " + p for p in cred_hit),
        "   这类文件只存在于本地磁盘；要入库的模板用同名 .example 文件（不得填真值）。")
    tail_hint()
    sys.exit(1)

# ─── K. 提醒：本次提交改了团队基建内核文件（只提醒，不拦）────────────────
# 内核文件来自 team-kit，各工程逐字相同；清单与 kit 同步时的摘要在仓库根 .team-kit.json。
# 暂存内容与记录的摘要相同 ⇒ 是 kit 同步带来的，不提醒；不同或被删 ⇒ 是本工程私改，提醒收回 kit。
import hashlib, json
def kernel_reminder():
    root = git("rev-parse", "--show-toplevel").decode().strip()
    try:
        with open(os.path.join(root, ".team-kit.json"), encoding="utf-8") as f:
            recorded = json.load(f).get("files", {})
    except (OSError, ValueError):
        return
    changed = []
    entries = git("diff", "--cached", "--name-status", "-z", "--no-renames").split(b"\0")
    for i in range(0, len(entries) - 1, 2):
        status, p = entries[i].decode(), entries[i + 1].decode("utf-8", "replace")
        if p not in recorded:
            continue
        if status.startswith("D"):
            changed.append(p + "（删除）")
            continue
        blob = subprocess.run(["git", "show", ":" + p], check=True, stdout=subprocess.PIPE).stdout
        if hashlib.sha256(blob).hexdigest() != recorded[p]:
            changed.append(p)
    if changed:
        say("ℹ️  本次提交改了团队基建内核文件（来自 team-kit，各工程应逐字相同）：",
            *("   " + p for p in changed),
            "   这些改动只在本工程生效，下次 kit sync 会拒绝同步。确属改进的，请收回 team-kit：",
            "   在 kit 仓库执行 bin/kit adopt <本工程路径>，提交 kit 后再 sync 到各工程。")
kernel_reminder()

# ─── A2. 提交内容里出现有真值的口令字段 ──────────────────────────────
# 值必须「像口令」才报：纯 ASCII、去空白后非空、长度 >= 4、不是常见假值与占位。
#   配置类文件（.env/.ini/.yaml/.conf/.toml/.properties/.sh 等）：裸值与带引号的值都扫。
#   代码文件：只认字面量——字段直接等于字面量、带类型标注后等于字面量、
#     或同一行声明里用 default= 给了字面量；标识符、属性访问、函数调用是表达式，不是口令。
#   .vue 动态绑定（:x、@x、v-bind:x、v-on:x、#x）：属性值是 JS 表达式，整体是字面量才扫。
#   Markdown 里反引号是行内代码，不是字符串字面量。
#   值里含 $(…) / ${…} 是运行时展开生成的，不是字面口令。
# 测试文件与 .example 跳过内容扫描：夹具本就该带假口令，逐个加白名单是打地鼠。
# 代价（如实说）：真凭据藏进测试文件不会被本门拦住；凭据文件名的拦截（A1）不受此豁免。
KEY = re.compile(r"(password|passwd|secret_key|api_key|token)\b\s*[=:]\s*", re.I)
# 带引号的键（JSON / 字典 / JS 对象里的 "password": "…"）：键必须是完整的引号串、紧跟冒号，
# 且出现在对象键的位置（行首、空白、{ , ( [ 之后）。三元运算的 ? "A_PASSWORD" : "B" 不是键值对，跳过；
# HTML 属性 v-model="password" :type 的引号前是 =，不在键位置。
QKEY = re.compile(r"(?:^|(?<=[{,(\[\s]))[\x27\"][\w.-]*(password|passwd|secret_key|api_key|token)[\x27\"]\s*:\s*", re.I)

def key_matches(text):
    for m in KEY.finditer(text):
        yield m
    for m in QKEY.finditer(text):
        if not text[:m.start()].rstrip().endswith("?"):
            yield m

def literal_res(backtick):
    # 带引号的字面量；反斜杠转义的引号留在值里，藏不住后缀。
    lit = r"(?:\x27(?:\\.|[^\x27\\])*\x27|\"(?:\\.|[^\"\\])*\"" + (r"|`(?:\\.|[^`\\])*`" if backtick else "") + ")"
    return (re.compile(lit),
            re.compile(r"[A-Za-z_][\w.\[\]|, <>]*?\s*=(?![=>])\s*(?P<lit>" + lit + ")"),   # 带类型标注
            re.compile(r"\b(?:server_)?default\s*=\s*(?P<lit>" + lit + ")"))               # 声明里的 default=

CODE_LIT = literal_res(True)
PROSE_LIT = literal_res(False)
PROSEPATH = re.compile(r"\.(md|markdown)$", re.I)
EXPANSION = re.compile(r"\$[({]")
VUE_DYNAMIC = re.compile(r"(?:^|[\s<])(?:[:@#]|v-[\w-]+:)(?:[\w-]+:)?$")
VUE_ATTR = re.compile(r"\"([^\"]*)\"|\x27([^\x27]*)\x27")
DUMMY = {"secret", "dummy", "fake", "test", "testing", "example", "password", "pass", "none", "null"}
# 脱敏后的证据值（[REDACTED] 等）不是口令
REDACTED = re.compile(r"^\[(redacted|masked|hidden|removed|filtered|omitted)\]$", re.I)
# 变量与命令展开、格式占位、<占位>、***、...、xxx 等都不是字面口令
PLACEHOLDER = re.compile(r"^[\x27\"]?(\$[\w{(@*#?!-]|%|<|\*{3,}|\.{3}|xxx|placeholder|changeme|your[-_]?)", re.I)
TESTPATH = re.compile(r"(^|/)tests?/|\.test\.|\.spec\.|(^|/)test_|_test\.", re.I)
# docs/ 下是文档（测试方案、报告、证据），不是测试代码：docs/tests/ 不享受测试豁免。
DOCSPATH = re.compile(r"(^|/)docs/", re.I)
CONFIGPATH = re.compile(r"(^|/)\.env(\.|$)|(^|/)\.(npmrc|pypirc|netrc)$|(^|/)Dockerfile(\.[\w-]+)?$"
                        r"|\.(env|ini|cfg|cnf|conf|properties|toml|ya?ml|sh|bash)$", re.I)

def unquote(p):
    if len(p) >= 2 and p[0] == p[-1] == "\"":      # git 对特殊字符路径做 C 风格转义
        p = p[1:-1].encode("utf-8").decode("unicode_escape").encode("latin-1").decode("utf-8", "replace")
    return p[2:] if p.startswith("b/") else p

def looks_secret(val):
    if not val.strip() or PLACEHOLDER.match(val) or EXPANSION.search(val):
        return False
    if not val.isascii() or len(val) < 4 or val.lower() in DUMMY:
        return False
    if REDACTED.match(val) or re.sub(r"[^a-z0-9]", "", val.lower()) in DUMMY:   # 如 #password、<password>
        return False
    if ALLOW_VALUE and ALLOW_VALUE.fullmatch(val):
        return False
    return True

def value_of(line, m, kind):
    rest = line[m.end():]
    literal, typed, default = PROSE_LIT if kind == "prose" else CODE_LIT
    if kind == "vue" and VUE_DYNAMIC.search(line[:m.start()]):
        attr = VUE_ATTR.match(rest)
        if not attr:
            return None
        expr = (attr.group(1) if attr.group(1) is not None else attr.group(2)).strip()
        lit = literal.fullmatch(expr)
        return lit.group(0)[1:-1] if lit else None
    lit = literal.match(rest)
    if lit:
        return lit.group(0)[1:-1]
    if kind == "config":
        return (rest.split(None, 1)[0] if rest.strip() else "").strip("\x27\"`,;)")
    found = typed.match(rest) or default.search(rest)
    return found.group("lit")[1:-1] if found else None

def kind_of(path):
    if CONFIGPATH.search(path) or (CONFIG_EXTRA and CONFIG_EXTRA.search(path)):
        return "config"
    if path.endswith(".vue"):
        return "vue"
    if PROSEPATH.search(path):
        return "prose"
    return "code"

diff = git("diff", "--cached", "-U0", "--no-color", "--no-ext-diff", "--no-textconv",
           "--src-prefix=a/", "--dst-prefix=b/", "--diff-filter=ACMR",
           "--", ".", ":(exclude)*.example").decode("utf-8", "replace")
hits = []
path, skip, kind, header = "", True, "code", False
for line in diff.splitlines():
    if line.startswith("diff --git "):
        header = True
        continue
    if header:
        if line.startswith("+++ "):                 # 新文件段：判这个文件扫不扫、按哪类扫
            path = unquote(line[4:].strip())
            skip = bool((TESTPATH.search(path) and not DOCSPATH.search(path)) or (TEST_EXTRA and TEST_EXTRA.search(path)))
            kind = kind_of(path)
        elif line.startswith("@@"):
            header = False
        continue
    if skip or not line.startswith("+"):
        continue
    text = line[1:]
    # 一行可能同时有空字段与真实口令，须逐字段扫描。
    for m in key_matches(text):
        val = value_of(text, m, kind)
        if val is not None and looks_secret(val):
            hits.append(f"{path}: {text.strip()[:160]}")
            break

if hits:
    say("❌ 提交内容疑似含明文凭据：", *("   " + h for h in hits[:5]))
    if len(hits) > 5:
        say(f"   …共 {len(hits)} 处，仅列前 5 处。")
    say("   改为从本地不入库的凭据文件读取，或用 ${VAR} 占位。")
    tail_hint()
    say("   确属误报时用 git commit --no-verify（并说明理由）。")
    sys.exit(1)
sys.exit(0)
'
