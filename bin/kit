#!/usr/bin/env python3
"""team-kit：把团队基建内核同步到工程，并核对工程是否与内核一致。

用法（kit 仓库内执行，<工程> 为工程根目录）：
  bin/kit install <工程> [--force] [--allow-dirty] 首次安装：拷内核、建软链、生成工程专属文件模板、装钩子
  bin/kit sync    <工程> [--force] [--allow-dirty] 同步内核到工程（工程里改过内核文件、或已有 kit 未接管过的同名文件时拒绝，--force 覆盖）
  bin/kit check   <工程>                          核对一致性；不一致退出 1
  bin/kit diff    <工程> [路径 …]                 打印工程与内核的差异
  bin/kit adopt   <工程> [路径 …] [--force]       把工程里改过的内核文件收回 kit 的 template/（不提交）

退出码：0 一致 / 成功 · 1 有差异或被拒 · 2 用法错误
"""
import argparse
import difflib
import hashlib
import json
import os
import shutil
import subprocess
import sys
from datetime import datetime, timezone

KIT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
TEMPLATE = os.path.join(KIT, "template")
PROFILE = os.path.join(KIT, "profile")
STAMP = ".team-kit.json"
SYMLINKS = {".claude/skills": "../skills", ".codex/skills": "../skills"}
GITIGNORE_LINE = ".team-ledger/"
PROFILE_DOC = "docs/rules/工程配置.md"
UI_INSTANCE_DOC = "docs/rules/UI设计规范-本工程实例.md"
IGNORED_NAMES = {"__pycache__", ".DS_Store"}


def manifest_entries():
    with open(os.path.join(KIT, "MANIFEST"), encoding="utf-8") as f:
        return [l.strip() for l in f if l.strip() and not l.lstrip().startswith("#")]


def _walk(base, rel_dir):
    out = []
    root = os.path.join(base, rel_dir)
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if d not in IGNORED_NAMES)
        for name in sorted(filenames):
            if name in IGNORED_NAMES or name.endswith(".pyc"):
                continue
            out.append(os.path.relpath(os.path.join(dirpath, name), base))
    return out


def kernel_files():
    """内核文件（相对工程根）与目录型条目。"""
    files, dirs = [], []
    for e in manifest_entries():
        if e.endswith("/"):
            dirs.append(e.rstrip("/"))
            files.extend(_walk(TEMPLATE, e.rstrip("/")))
        else:
            files.append(e)
    return files, dirs


def sha(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        h.update(f.read())
    return h.hexdigest()


def is_exec(path):
    return os.access(path, os.X_OK)


def git(project, *args, check=False):
    return subprocess.run(["git", "-C", project, *args], capture_output=True, text=True, check=check)


def kit_commit():
    head = git(KIT, "rev-parse", "HEAD").stdout.strip() or "unknown"
    dirty = bool(git(KIT, "status", "--porcelain").stdout.strip())
    return head + ("+dirty" if dirty else "")


def kit_version():
    """最近的版本标签；标签之后还有提交时为「标签-距离-g提交」，没有标签时为提交号缩写。"""
    v = git(KIT, "describe", "--tags", "--always").stdout.strip() or "unknown"
    dirty = bool(git(KIT, "status", "--porcelain").stdout.strip())
    return v + ("+dirty" if dirty else "")


def kernel_changed_since(commit):
    """工程上次同步之后，kit 里会进工程的东西（template/、profile/、MANIFEST）有没有变。
    只改 kit 自己的文档、工具或测试不算——工程无须 sync。判不了（提交号缺失、带 +dirty、kit 里找不到）按「变了」报。"""
    if not commit or commit.endswith("+dirty"):
        return True
    r = git(KIT, "diff", "--quiet", commit, "--", "template", "profile", "MANIFEST")
    if r.returncode != 0:          # 1 = 有差异；其他 = 判不了
        return True
    return bool(git(KIT, "status", "--porcelain", "--", "template", "profile", "MANIFEST").stdout.strip())


def read_stamp(project):
    p = os.path.join(project, STAMP)
    if not os.path.exists(p):
        return None
    with open(p, encoding="utf-8") as f:
        return json.load(f)


def profile_sections():
    with open(os.path.join(PROFILE, PROFILE_DOC), encoding="utf-8") as f:
        return [l.strip() for l in f if l.startswith("## ")]


# ---------- check ----------

def check(project, quiet=False):
    errors, warns = [], []
    files, dirs = kernel_files()
    for rel in files:
        src, dst = os.path.join(TEMPLATE, rel), os.path.join(project, rel)
        if not os.path.exists(dst):
            errors.append(f"缺失    {rel}")
        elif sha(src) != sha(dst):
            errors.append(f"不一致  {rel}")
        elif is_exec(src) != is_exec(dst):
            errors.append(f"权限    {rel}（可执行位与内核不同）")
    tset = set(files)
    for d in dirs:
        if os.path.isdir(os.path.join(project, d)):
            for rel in _walk(project, d):
                if rel not in tset:
                    errors.append(f"多出    {rel}（内核目录里没有）")
    for link, target in SYMLINKS.items():
        p = os.path.join(project, link)
        if not os.path.islink(p) or os.readlink(p) != target:
            errors.append(f"软链    {link} 应指向 {target}")
    for rel in _walk(PROFILE, "."):
        if not os.path.exists(os.path.join(project, rel)):
            errors.append(f"工程专属 {rel} 不存在（kit sync 会生成模板）")
    pdoc = os.path.join(project, PROFILE_DOC)
    if os.path.exists(pdoc):
        text = open(pdoc, encoding="utf-8").read()
        have = {l.strip() for l in text.splitlines() if l.startswith("## ")}
        for s in profile_sections():
            if s not in have:
                errors.append(f"工程配置 缺节「{s[3:]}」（节名是内核引用的锚点）")
        if "<例" in text or "<…>" in text:
            warns.append(f"工程配置 {PROFILE_DOC} 仍有未填的模板占位")
    # 其余工程专属文件：模板里整行是 <…> 的占位，原样留在工程里 ⇒ 还没填
    for rel in _walk(PROFILE, "."):
        dst = os.path.join(project, rel)
        if rel == PROFILE_DOC or not os.path.exists(dst) or not rel.endswith(".md"):
            continue
        holders = {l.strip() for l in open(os.path.join(PROFILE, rel), encoding="utf-8")
                   if l.strip().startswith("<") and l.strip().endswith(">")}
        if holders & {l.strip() for l in open(dst, encoding="utf-8")}:
            warns.append(f"工程专属 {rel} 仍有未填的模板占位")
    hp = git(project, "config", "--get", "core.hooksPath").stdout.strip()
    if hp != ".githooks":
        errors.append(f"钩子    core.hooksPath={hp or '未设置'}，应为 .githooks（执行 bash .githooks/install.sh）")
    gi = os.path.join(project, ".gitignore")
    lines = open(gi, encoding="utf-8").read().splitlines() if os.path.exists(gi) else []
    if not any(l.strip().rstrip("/") == GITIGNORE_LINE.rstrip("/") for l in lines):
        errors.append(f".gitignore 缺 {GITIGNORE_LINE}（账本与交接文档不入库）")
    stamp = read_stamp(project)
    if stamp is None:
        warns.append(f"{STAMP} 不存在（未经 kit 安装）")
    elif stamp.get("kit_commit") != kit_commit() and kernel_changed_since(stamp.get("kit_commit")):
        warns.append(f"{STAMP} 记录的 kit 为 {stamp.get('kit_version', '?')}（{stamp.get('kit_commit')}），"
                     f"当前 kit 为 {kit_version()}（{kit_commit()}）：内核有更新，该工程待 sync")
    if not quiet:
        print(f"[kit check] {project}")
        print(f"  内核 {len(files)} 个文件，kit {kit_version()}（{kit_commit()}）")
        for e in errors:
            print("  ✗ " + e)
        for w in warns:
            print("  ! " + w)
        print("  ✓ 与内核一致" if not errors else f"  共 {len(errors)} 处不一致")
    return errors, warns


# ---------- install / sync ----------

def dirty_kernel_paths(project, files):
    existing = [f for f in files if os.path.exists(os.path.join(project, f))]
    if not existing:
        return []
    out = git(project, "status", "--porcelain", "--", *existing).stdout
    return [l for l in out.splitlines() if l.strip()]


def write_stamp(project, files):
    data = {
        "kit_version": kit_version(),
        "kit_commit": kit_commit(),
        "synced_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "files": {f: sha(os.path.join(project, f)) for f in files},
    }
    with open(os.path.join(project, STAMP), "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")


def apply(project, mode, force=False, allow_dirty=False):
    if not os.path.isdir(os.path.join(project, ".git")) and not git(project, "rev-parse", "--git-dir").stdout.strip():
        print(f"[kit {mode}] {project} 不是 git 仓库", file=sys.stderr)
        return 1
    files, _ = kernel_files()
    if not allow_dirty:
        dirty = dirty_kernel_paths(project, files)
        if dirty:
            print(f"[kit {mode}] 拒绝：工程里这些内核文件有未提交改动（先提交或另行处理，或加 --allow-dirty）：", file=sys.stderr)
            for l in dirty:
                print("  " + l, file=sys.stderr)
            return 1
    stamp = read_stamp(project)
    if not force:
        recorded = (stamp or {}).get("files", {})
        local, unmanaged = [], []
        for rel in files:
            dst = os.path.join(project, rel)
            if not os.path.exists(dst) or sha(dst) == sha(os.path.join(TEMPLATE, rel)):
                continue
            if rel not in recorded:
                unmanaged.append(rel)
            elif sha(dst) != recorded[rel]:
                local.append(rel)
        if local:
            print(f"[kit {mode}] 拒绝：工程里改过这些内核文件，先把改进收回 kit（bin/kit diff 查看），或加 --force 覆盖：", file=sys.stderr)
            for rel in local:
                print("  " + rel, file=sys.stderr)
        if unmanaged:
            print(f"[kit {mode}] 拒绝：工程里已有这些同名文件，kit 未接管过，内容与内核不同"
                  "（先把本工程专属内容移走、通用改进收回 kit，bin/kit diff 查看），或加 --force 覆盖：", file=sys.stderr)
            for rel in unmanaged:
                print("  " + rel, file=sys.stderr)
        if local or unmanaged:
            return 1
    changed = []
    for rel in files:
        src, dst = os.path.join(TEMPLATE, rel), os.path.join(project, rel)
        if os.path.exists(dst) and sha(src) == sha(dst) and is_exec(src) == is_exec(dst):
            continue
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copy2(src, dst)
        changed.append(rel)
    for link, target in SYMLINKS.items():
        p = os.path.join(project, link)
        if os.path.islink(p):
            if os.readlink(p) != target:
                os.remove(p)
                os.symlink(target, p)
                changed.append(link)
        elif os.path.exists(p):
            print(f"[kit {mode}] {link} 是实体目录而不是软链，未改动，请人工处理", file=sys.stderr)
        else:
            os.makedirs(os.path.dirname(p), exist_ok=True)
            os.symlink(target, p)
            changed.append(link)
    created = []
    for rel in _walk(PROFILE, "."):
        dst = os.path.join(project, rel)
        if not os.path.exists(dst):
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copy2(os.path.join(PROFILE, rel), dst)
            created.append(rel)
    gi = os.path.join(project, ".gitignore")
    lines = open(gi, encoding="utf-8").read().splitlines() if os.path.exists(gi) else []
    if not any(l.strip().rstrip("/") == GITIGNORE_LINE.rstrip("/") for l in lines):
        with open(gi, "a", encoding="utf-8") as f:
            if lines and lines[-1].strip():
                f.write("\n")
            f.write("# 团队状态账本与交接文档（team-kit）：不入库，各 worktree 共用主工作树那一份\n")
            f.write(GITIGNORE_LINE + "\n")
        changed.append(".gitignore")
    hook_install = os.path.join(project, ".githooks/install.sh")
    if os.path.exists(hook_install):
        r = subprocess.run(["bash", hook_install], cwd=project, capture_output=True, text=True)
        if r.returncode != 0:
            print(f"[kit {mode}] 钩子安装失败：{r.stderr.strip()}", file=sys.stderr)
            return 1
    write_stamp(project, files)
    print(f"[kit {mode}] {project}  kit {kit_version()}（{kit_commit()}）")
    print(f"  更新 {len(changed)} 处" + ("：" if changed else ""))
    for c in changed:
        print("    " + c)
    for c in created:
        print(f"  新建工程专属文件 {c}（请按本工程填写，kit 之后不再覆盖）")
    print("  未提交：请在工程里核对后自行提交（含 .team-kit.json）。同一工作树里可能有别人暂存的改动，提交一律带路径：")
    paths = [STAMP] + [c for c in changed if c != STAMP] + created
    print(f'    git -C {project} commit -m "<提交信息>" -- ' + " ".join(paths))
    if created:
        print("    （新建的工程专属文件须先 git add 再提交）")
    return 0


def merge3(base_commit, rel, ours_path, theirs_path):
    """三方合并：base = 该工程上次同步时 kit 的那一版，ours = kit 现在的 template，theirs = 工程里的。
    返回合并后的字节；取不到基线或有冲突时返回 None。"""
    if not base_commit or base_commit.endswith("+dirty"):
        return None
    b = subprocess.run(["git", "-C", KIT, "show", f"{base_commit}:template/{rel}"], capture_output=True)
    if b.returncode != 0:
        return None
    import tempfile
    with tempfile.NamedTemporaryFile(delete=False) as f:
        f.write(b.stdout)
        base_path = f.name
    try:
        r = subprocess.run(["git", "merge-file", "-p", ours_path, base_path, theirs_path], capture_output=True)
    finally:
        os.unlink(base_path)
    return r.stdout if r.returncode == 0 else None


def adopt(project, paths, force=False):
    """把工程里改过（或在内核目录里新增）的内核文件拷回 template/。

    kit 在该工程上次同步之后自己也改过同一文件（template 摘要 ≠ .team-kit.json 记录）时，直接拷回会冲掉
    kit 的新改动：先以上次同步时的 kit 版本为基线做三方合并，两边改的不是同一处就合并收回；
    有冲突（或取不到基线）则拒绝该文件，要求人工合并；--force 明确用工程版覆盖。
    """
    files, dirs = kernel_files()
    tset = set(files)
    candidates = list(files)
    for d in dirs:
        if os.path.isdir(os.path.join(project, d)):
            candidates += [r for r in _walk(project, d) if r not in tset]
    if paths:
        wanted = {os.path.normpath(p) for p in paths}
        unknown = sorted(w for w in wanted if w not in set(candidates))
        if unknown:
            print("[kit adopt] 这些路径不是内核文件：" + "、".join(unknown), file=sys.stderr)
            return 2
        candidates = [c for c in candidates if c in wanted]
    dirty = git(KIT, "status", "--porcelain", "--", *[os.path.join("template", c) for c in candidates]).stdout.strip()
    if dirty:
        print("[kit adopt] 拒绝：kit 的 template/ 里这些文件有未提交改动，先在 kit 提交或处理：", file=sys.stderr)
        print("  " + dirty.replace("\n", "\n  "), file=sys.stderr)
        return 1
    stamp = read_stamp(project) or {}
    recorded = stamp.get("files", {})
    adopted, merged, conflicts, missing = [], [], [], []
    for rel in candidates:
        src, dst = os.path.join(project, rel), os.path.join(TEMPLATE, rel)
        if not os.path.exists(src):
            if rel in tset:
                missing.append(rel)
            continue
        if os.path.exists(dst) and sha(src) == sha(dst) and is_exec(src) == is_exec(dst):
            continue
        if os.path.exists(dst) and rel in recorded and sha(dst) != recorded[rel] and not force:
            out = merge3(stamp.get("kit_commit"), rel, dst, src)
            if out is None:
                conflicts.append(rel)
            else:
                with open(dst, "wb") as f:
                    f.write(out)
                merged.append(rel)
            continue
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copy2(src, dst)
        adopted.append(rel)
    print(f"[kit adopt] {project} → {TEMPLATE}")
    for rel in adopted:
        print("  收回  " + rel)
    for rel in merged:
        print("  合并  " + rel + "（kit 与工程改的不是同一处，已三方合并；请核对合并结果）")
    for rel in missing:
        print(f"  ! {rel} 在工程里被删了；adopt 不删 kit 里的文件，确要删请在 kit 里手工删并改 MANIFEST")
    if conflicts:
        print("  ✗ 下列文件在该工程上次同步后 kit 也改过，且两边改到了同一处（或取不到同步时的基线），未收回"
              "（bin/kit diff 对照后人工合并，或 --force 用工程版覆盖）：")
        for rel in conflicts:
            print("    " + rel)
    if not adopted and not merged and not conflicts and not missing:
        print("  工程与内核一致，没有可收回的改动")
    if adopted or merged:
        print("  下一步：在 kit 跑三套测试 → 提交 kit → 对每个工程 bin/kit sync → 各工程提交")
    return 1 if conflicts else 0


def diff(project, paths):
    files, _ = kernel_files()
    targets = paths or files
    found = False
    for rel in targets:
        src, dst = os.path.join(TEMPLATE, rel), os.path.join(project, rel)
        a = open(src, encoding="utf-8", errors="replace").read().splitlines(True) if os.path.exists(src) else []
        b = open(dst, encoding="utf-8", errors="replace").read().splitlines(True) if os.path.exists(dst) else []
        d = list(difflib.unified_diff(a, b, f"kit/{rel}", f"工程/{rel}"))
        if d:
            found = True
            sys.stdout.writelines(d)
    return 1 if found else 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="kit", description="team-kit 内核同步与一致性核对")
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("install", "sync"):
        p = sub.add_parser(name)
        p.add_argument("project")
        p.add_argument("--allow-dirty", action="store_true")
        p.add_argument("--force", action="store_true")
    p = sub.add_parser("check")
    p.add_argument("project")
    p = sub.add_parser("diff")
    p.add_argument("project")
    p.add_argument("paths", nargs="*")
    p = sub.add_parser("adopt")
    p.add_argument("project")
    p.add_argument("paths", nargs="*")
    p.add_argument("--force", action="store_true")
    a = ap.parse_args(argv)
    project = os.path.realpath(a.project)
    if not os.path.isdir(project):
        print(f"{project} 不是目录", file=sys.stderr)
        return 2
    if a.cmd == "check":
        errors, _ = check(project)
        return 1 if errors else 0
    if a.cmd == "diff":
        return diff(project, a.paths)
    if a.cmd == "adopt":
        return adopt(project, a.paths, force=a.force)
    return apply(project, a.cmd, force=a.force, allow_dirty=a.allow_dirty)


if __name__ == "__main__":
    sys.exit(main())
